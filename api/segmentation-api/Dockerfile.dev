FROM node:20-bookworm

WORKDIR /app

# Install Python for segmentation
RUN apt-get update \
	&& apt-get install -y python3 python3-pip \
	&& rm -rf /var/lib/apt/lists/*

# Install Node dependencies first (cached layer)
# Skip postinstall scripts since Prisma schema isn't copied yet
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy Prisma schema and config (needed for prisma generate)
COPY prisma ./prisma

# Generate Prisma client now that schema is available
RUN npx prisma generate

# Install Python dependencies
# Use --break-system-packages since we're in an isolated Docker container
COPY python/requirements.txt ./python/
RUN --mount=type=cache,target=/root/.cache/pip \
	pip3 install --break-system-packages -r python/requirements.txt

# Copy remaining source code (will be overridden by volume mount in dev)
COPY . .

EXPOSE 3000

# Run dev server with watch mode (and apply migrations)
CMD ["sh", "./scripts/start-dev.sh"]
